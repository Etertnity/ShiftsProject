# Скрипты для Linux-сервера должны иметь LF, иначе bash/sh на VPS падает с "\r: command not found"
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
# Скрипты Windows — всегда с CRLF, иначе cmd ломается на русском тексте и метках
*.bat text eol=crlf
