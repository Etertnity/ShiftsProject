# Шаблон настроек. Скопируйте в .env (в корне проекта) и заполните.
# На сервере .env создаёт deploy-vps.sh. Файл .env содержит секреты: не коммитьте и не пересылайте его.

# development — локальная разработка (включена документация API /docs);
# production — сервер (документация выключена). docker-compose.prod.yml выставляет production сам
APP_ENV=development

# Ключ подписи токенов входа. На сервере обязателен: openssl rand -hex 32
# Пусто — ключ сгенерируется и сохранится в data/.secret_key рядом с базой
SECRET_KEY=

# База данных (путь относительно папки backend / рабочей папки контейнера)
DATABASE_URL=sqlite:///./data/shifts.db

# Сколько минут действует вход (по умолчанию сутки — смена длится 12 часов)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Адреса, с которых браузер может обращаться к API, через запятую.
# Пусто — только с того же адреса, что и сайт (так работает nginx). '*' в продакшене не используйте
CORS_ORIGINS=

# Часовой пояс смен и журнала передач
APP_TIMEZONE=Europe/Moscow

# Первый администратор — создаётся при старте, только если администраторов ещё нет.
# Пароль пустой — сгенерируется случайный и один раз напечатается в логе бэкенда.
# При первом входе система в любом случае потребует задать свой пароль
DEFAULT_ADMIN_USERNAME=Sideffect
DEFAULT_ADMIN_PASSWORD=

# Защита от подбора пароля: после N неудачных попыток вход по этому логину и с этого адреса
# блокируется на M минут
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Включить /docs в продакшене (не рекомендуется): true
ENABLE_API_DOCS=

LOG_LEVEL=INFO

# ICMP-монитор (страница «ICMP-монитор»). Пока ZABBIX_URL пуст, страница покажет, что монитор не настроен.
# Логин/пароль — отдельный пользователь Zabbix только с правом чтения истории.
ZABBIX_URL=http://zabbix.example.local:8080/api_jsonrpc.php
ZABBIX_USER=
ZABBIX_PASSWORD=
# Адрес веб-интерфейса Zabbix для кнопки «Открыть в Zabbix» (необязательно)
ZABBIX_WEB_URL=http://zabbix.example.local:8080
# Пороги потерь, %: жёлтый и красный
MONITOR_WARN_THRESHOLD=40
MONITOR_CRIT_THRESHOLD=60
